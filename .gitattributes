# Edited on Windows, built on Linux CI. Without this file a core.autocrlf=true working
# tree hands CI different bytes than the author sees, which breaks any pipeline that
# hashes file contents.
* text=auto eol=lf

*.png  -text
*.jpg  -text
*.jpeg -text
*.webp -text
*.gif  -text
*.ico  -text
*.woff  -text
*.woff2 -text
*.ttf  -text
*.otf  -text
