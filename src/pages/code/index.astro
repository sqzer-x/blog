---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { hasHangul, langOf } from '../../lib/hangul';
import { assertRendered } from '../../lib/rendered';

/*
 * Authorial order, and nothing else. `order` ascending is the whole sort: the reference's
 * own code page is hand-ranked, and the author reorders this page by changing one number
 * in front matter. Name and id break a tie only so the output is stable rather than
 * filesystem-ordered — the same reason src/lib/order.ts refuses to delegate that. There
 * is no date on this collection to sort by and no star count to let GitHub sort it.
 */
const collator = new Intl.Collator('en');
const projects = (await getCollection('code'))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) =>
      a.data.order - b.data.order ||
      collator.compare(a.data.name, b.data.name) ||
      (a.id < b.id ? -1 : a.id > b.id ? 1 : 0),
  );

/* The description is each file's markdown body, so every entry has to be rendered before
   the template can lay it out. One `render()` call per entry, resolved together. */
projects.forEach(assertRendered);
const entries = await Promise.all(
  projects.map(async (p) => ({ entry: p, Content: (await render(p)).Content })),
);

/* The same question src/pages/index.astro asks of about.md, and for the same reason: the
   metadata on this route is English whatever the content says, so only the content can
   answer whether the 118KB Korean face blocks first paint. Every name and description is
   English today, so the answer is false and /code/ fetches no Korean font, as the `ko`
   note in Base.astro says; the day one of them is written in Korean, it becomes true. */
const ko = projects.some((p) => hasHangul(p.data.name, p.body));
---
<Base
  title="Code :: sqzer"
  description="Tools and small programs I have written and published."
  ko={ko}
>
  <div class="code-index">
      {/* The reference carries no page title on its section pages: the bar's left slot
          already prints the page name, so an <h1> repeating it is the same word twice.
          Kept in the document as .sr-only rather than deleted — the page still needs one
          top-level heading for assistive tech and for the document outline, and the bar's
          slot is a <span> precisely because it is not one. */}
      <h1 class="sr-only">Code</h1>

    {entries.length === 0 ? (
      <p class="code-index__empty">Nothing here yet.</p>
    ) : (
      <ul class="projects">
        {entries.map(({ entry, Content }) => (
          <li class="project">
            <h2 class="project__name" lang={langOf(entry.data.name, 'en')}>
              <a href={entry.data.url}>{entry.data.name}</a>
            </h2>
            <div class="project__about" lang={hasHangul(entry.body) ? 'ko' : undefined}>
              <Content />
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  /* Capped at the site's measure, the same 928px an article's prose and the Writing
     index's entry column get.

     Capped WITHOUT `margin-inline: auto`, and that is the load-bearing half. `main` caps
     at --w-page (1024px) and centres itself; centring a narrower box inside it again
     would step this page's list ~48px right of `main`'s left edge, which is where the
     header's page name and the text of /papers/ and /talk/ start. With margin-inline at
     its 0 default the box keeps `main`'s left edge and gives the 96px back on the right —
     the mirror of /writing/, where that same 96px is the date rail on the left. */
  .code-index {
    max-width: var(--w-content);
  }

  .code-index__empty {
    font-size: var(--fs-body);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The reference separates its entries with a single blank line and nothing else: no
     rule, no wash, no row-sized hit area. Copied as it stands rather than borrowing the
     Writing index's row treatment, because that treatment is answering a different
     question — a row on /writing/ is one whole link to a page of this site, so the row
     can be the control. A row here is a name that leaves the site, so the name is the
     control, and there is nothing else on the row to make clickable. Hairlines between
     entries would be furniture the reference does not have and this page does not
     need. */
  .project + .project {
    margin-top: var(--sp-32);
  }

  /* h2 is the right element — this is a list of named things directly under the page's
     h1, and a screen reader should be able to walk it — but not the right size. --fs-h2
     reaches 28.5px, which reads as a run of section headings; --fs-h5 is what the
     Writing index sets its entry titles at. Family, weight and colour come from
     base.css's heading rule, and the link keeps the heading's 500 through the global
     `a { font-weight: inherit }`. */
  .project__name {
    font-size: var(--fs-h5);
    line-height: var(--lh-medium);
    text-wrap: balance;
  }

  /* Crimson, no underline: the colour-only treatment base.css gives <a>, and here
     the link IS the entry's headline, so the colour is the whole affordance. --crimson
     measures 7.25:1 against --page-bg, over the 4.5:1 normal text needs, so the colour is
     not carrying meaning at a contrast that fails — and it lands within 0.23 of the
     7.48:1 the reference sets its own outbound links at.
     Hover and keyboard focus step the colour to --crimson-lift. The hover half sits
     inside the pointer gate: a bare :hover latches after a tap on a touch screen and would
     leave the project marked until the next tap elsewhere. :focus-visible stays outside
     the gate -- it is the keyboard path, and the global focus ring comes with it.
     The 0.05em of padding-block-end draws nothing. The link is inline, so it costs no
     layout; it only lowers the bottom of the link's box, and with it the focus ring and
     the hit area, by 0.05em: a pixel at 20px, 0.9px at the 18px floor. Check the ring
     before removing it. */
  .project__name a { color: var(--crimson); text-decoration: none; padding-block-end: 0.05em; }
  /* Hover is a colour step, not a rule. The reference draws its animated underline in one
     place only - the header nav - and every link in the body of a page, its writing index,
     its code list and even its year rail, simply lifts from rgb(160,32,32) to
     rgb(192,48,48) with no decoration at all. Measured over CDP on all three. */
  .project__name a:focus-visible { color: var(--crimson-lift); }
  @media (hover: hover) {
    .project__name a:hover { color: var(--crimson-lift); }
  }

  /* Forced colours force `color` to the system link colour at rest and on hover alike, so
     the colour step above does not show in that mode. An underline is what the mode can
     still draw, so hover and focus get one here and only here. Written in this file
     rather than in base.css because Astro scopes a page rule on every compound, which
     outranks the same selector written globally. */
  @media (forced-colors: active) {
    .project__name a:focus-visible { text-decoration: underline; }
  }
  @media (forced-colors: active) and (hover: hover) {
    .project__name a:hover { text-decoration: underline; }
  }

  /* margin-top is 0.375rem, matching .entry__deck on /writing/ — a description belongs
     to the name above it, so the gap has to read as smaller than the --sp-32 between
     entries.

     The other two are set here and not on a descendant selector because <Content />
     emits elements with no scope id, so `.project__about p` would miss every one of
     them. Both properties inherit, which is what lets the wrapper carry them.

     keep-all is a no-op on the English descriptions here and is the house rule
     everywhere Korean can appear (.prose, .about, .entry__title); `ko` above already
     anticipates a Korean description, so this does too. break-word is the guard against
     a long unbroken token such as a bare URL, which would otherwise set the page's
     minimum width and scroll it sideways on a phone. */
  .project__about {
    margin-top: 0.375rem;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
</style>
