---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byHugoOrder, postUrl } from '../../lib/order';
import { hasHangul, langOf } from '../../lib/hangul';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort(byHugoOrder);

// Grouped by year, matching the axis already present in the URL.
const years = [...new Set(posts.map((p) => p.data.date.slice(0, 4)))].sort().reverse();

/** Rail date. The year is stated by the section kicker, so only MM.DD is repeated. */
const md = (iso: string) => `${iso.slice(5, 7)}.${iso.slice(8, 10)}`;

const span = years.length ? `${years[years.length - 1]}–${years[0]}` : '';

/* This page is an English document - heading, year kickers, "30 posts" - that sets 21
   Korean titles, six of them above the fold. Deciding the font preload from the document
   language would skip the Korean face on the site's densest page and leave those titles
   in fallback until a third-wave request lands. Ask the strings that will be painted. */
const ko = posts.some((p) => hasHangul(p.data.title, p.data.deck));
---
<Base
  title="Writing :: sqzer"
  description="Essays and technical notes, 2024–2026."
  ko={ko}
>
  <div class="index">
      {/* The reference carries no page title on its section pages: the bar's left slot
          already prints the page name, so an <h1> repeating it is the same word twice.
          Kept in the document as .sr-only rather than deleted — the page still needs one
          top-level heading for assistive tech and for the document outline, and the bar's
          slot is a <span> precisely because it is not one. */}
      <h1 class="index__title sr-only">Writing</h1>

    {posts.length === 0 && <p class="index__empty">Nothing here yet.</p>}

    {years.map((y) => (
      <section class="year">
        <h2 class="year__label" id={y}>{y}</h2>
        <ol class="year__list">
          {posts.filter((p) => p.data.date.slice(0, 4) === y).map((p) => (
            <li class="entry" data-type={p.data.type}>
              <time class="entry__date" datetime={p.data.date}>{md(p.data.date)}</time>
              <h3 class="entry__title" lang={langOf(p.data.title, 'en')}>
                <a href={postUrl(p)}>{p.data.title}</a>
              </h3>
              {p.data.deck && (
                <p class="entry__deck" lang={hasHangul(p.data.deck) ? 'ko' : undefined}>{p.data.deck}</p>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  /* ────────────────────────────────────────────────────────────────
     Page-local tokens.
     Defers to the global token set once Base provides it; until then these stand alone
     using the clamp literals measured from the Gazette.
     ──────────────────────────────────────────────────────────────── */
  .index {
    /* Grid */
    /* Must equal --w-content in src/styles/tokens.css: this is what puts an entry title
       on the same left edge as the <h1> of the article it links to. Moving one without
       the other silently splits that edge - see the note beside --w-content.

       Bound through var() rather than re-stated, and the unit is why. The article caps
       at an absolute --w-content (928px); a rem literal here only matches it at a 16px
       root. Chrome's font-size setting is one click from 12px, and .index has
       margin-inline: auto, so the moment its cap falls below the shell the box centres
       and the two left edges part. Measured with a 58rem literal at a 12px root: the
       article <h1> landed 116px left of the entry title at 1488 and 1920, and 103.5px
       left at 1024; at 14px, 58px and 38.6px. Through var() it is 0.00px at 12 / 14 /
       16 / 20 / 24px roots, because both pages then cap on the same absolute length.
       The 58rem fallback is the stand-alone value, used only if Base ships no tokens -
       the same var(global, measured-literal) shape as the type scale below.

       One exception to the shared edge, and it is not this page's doing nor fixable from
       here: the nine articles that carry a contents rail push their own page box right
       between 1440 and 1584px, where a centred gutter cannot seat the rail's 240px floor.
       This page has no rail and nothing to make room for, so it deliberately does not
       follow - shifting it in sympathy would buy an empty 280px left gutter at 1440 for a
       page with nothing to put in it. Measured delta, article title minus entry title, at
       a 16px root: 72px at 1440, 48 at 1488, 24 at 1536, and 0.00px from 1584 up, at 1439
       and below, and at every width for the 21 articles with no rail. Those are
       layout-viewport widths, the same basis the Geometry note uses; a classic 15px
       scrollbar puts the band at 1440-1598 in window widths and the worst case at 79.5px,
       measured at a 1440px window. See the ══ Geometry ══ note in
       src/pages/writing/[year]/[slug].astro for why it was traded. */
    --content-w: var(--w-content, 58rem);   /* 928px, = --w-content */
    --rail-w: 4.5rem;      /* 72px date rail */
    --rail-gap: 1.5rem;    /* 24px  */

    /* Type scale, as measured */
    --fs-small:  var(--wp-small,  clamp(0.6875rem, 0.688rem + ((1vw - 0.2rem) * 0.256), 0.875rem));  /* 11→14 */
    --fs-medium: var(--wp-medium, clamp(0.75rem,   0.75rem  + ((1vw - 0.2rem) * 0.342), 1rem));      /* 12→16 */
    --fs-large:  var(--wp-large,  clamp(1rem,      1rem     + ((1vw - 0.2rem) * 0.342), 1.25rem));   /* 16→20 */
    --fs-h5:     var(--wp-h5,     clamp(1.25rem,   1.25rem  + ((1vw - 0.2rem) * 0.342), 1.5rem));    /* 20→24 */
    --fs-h1:     var(--wp-h1,     clamp(2.125rem,  2.125rem + ((1vw - 0.2rem) * 2.568), 4rem));      /* 34→64 */
    --fs-kicker: var(--wp-kicker, clamp(0.63rem,   0.36vw + 0.54rem, 0.88rem));                      /* 10.08→14.08 */

    --lh-tight: 1.1;
    --lh-medium: 1.4;
    --lh-base: 1.5;

    --gap-kicker: clamp(1rem, 0.72vw + 0.83rem, 1.5rem);                            /* 16→24 */
    --entry-pad:  clamp(0.75rem, 0.75rem + ((1vw - 0.2rem) * 0.342), 1rem);         /* 12→16 */
    --gap-section: clamp(2rem, 1.8rem + 1vw, 3rem);                                 /* spacing-48 */

    /* Colour: desk = crimson */
    --ppc-text: var(--desk-text, #771120);   /* dark   — kickers */
    --ppc-ui:   var(--desk-ui,   #a51c30);   /* base   — 4px rules, focus ring */
    --ppc-wash: var(--desk-wash, #f7ebeb);   /* wash   — row hover */
    --ink:      var(--color-black,      #000);
    --meta:     var(--color-slate,      #605a4e);
    --hairline: var(--color-grey,       #b9b8ad);
    --paper:    var(--color-sand-light, #fffbf4);

    --font-body:    var(--font-sans,  "Inter", "Pretendard", system-ui, sans-serif);
    --font-display: var(--font-serif, "Newsreader", "Pretendard", Georgia, serif);
    /* Swapping this one line to var(--font-body) flips all 30 titles to sans. */
    --index-title-font: var(--font-display);

    container: index / inline-size;
    max-width: min(100%, calc(var(--rail-w) + var(--rail-gap) + var(--content-w))); /* 1024px */
    margin-inline: auto;
    font-family: var(--font-body);
    color: var(--ink);
  }

  /* Masthead.
     Flush with the page box, NOT indented onto the entry column. It used to carry the
     same `padding-left: --rail-w + --rail-gap` the year kickers and the entries carry,
     which put "Writing" 96px in from the left edge — so this was the one section index
     whose title did not start where /papers/, /talk/ and /code/ start theirs. Reading
     the four in a row, /writing/ was visibly the odd one, and the h1 is the last thing
     that should be telling you which page you are on by moving.

     The 96px indent still belongs to everything below it: the year kicker and the entry
     titles hang off the 72px date rail, and that column is the page's spine. The
     masthead is not in that column — it is the page's own name, addressed to the shell,
     not a row in the list — so it takes the shell's edge. Measured after the change at a
     1700px window: 330.5px for the h1 on all four section indexes, against 426.5 here
     before it. */

  .index__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    color: var(--ink);
  }


  .index__empty {
    padding-left: calc(var(--rail-w) + var(--rail-gap));
    font-size: var(--fs-large);
    line-height: 1.6;
    color: var(--ink);
  }

  /* Year as section kicker, ported from .featured-articles__category */
  .year__label {
    position: sticky;
    top: var(--index-sticky-top, 0px);
    z-index: 2;
    margin: 0;
    padding: var(--gap-kicker) 0 var(--gap-kicker) calc(var(--rail-w) + var(--rail-gap));
    background: var(--paper);
    scroll-margin-top: var(--index-sticky-top, 0px);

    font-family: var(--font-body);
    font-size: var(--fs-kicker);
    font-weight: 700;
    line-height: var(--lh-medium);
    letter-spacing: 0.105rem;   /* 1.68px */
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--ppc-text);
  }

  /* Signature motif, used once per year heading — three times on this page. */
  .year__label::before {
    content: "";
    display: block;
    width: 3rem;
    border-top: 4px solid var(--ppc-ui);
    margin-bottom: var(--gap-kicker);
  }

  .year__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Entry */
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr);
    column-gap: var(--rail-gap);
    align-items: baseline;
    padding-block: var(--entry-pad);
    border-bottom: 1px solid var(--hairline);
    transition: background-color 0.12s linear;
  }

  .entry:last-child { border-bottom: none; }

  .entry__date {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;          /* right-aligned: the vertical spine of the page */
    font-size: var(--fs-small);
    line-height: var(--lh-base);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1;
    letter-spacing: 0.02em;
    color: var(--meta);
    white-space: nowrap;
  }

  .entry__title {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-family: var(--index-title-font);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: var(--lh-medium);
    color: var(--ink);
    word-break: keep-all;       /* stops Korean titles breaking mid-word */
    text-wrap: balance;
  }

  .entry__title a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole row is the hit area, ported from .featured-article__title a:before */
  .entry__title a::before {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* The row is still the trigger, and the hit area above is untouched: the rule is drawn
     by .hover-wipe (base.css) on the link's own background, not by a second pseudo-element,
     because ::before is already spent on the full-row hit box.

     This is the site that decided the technique. Korean titles wrap here and nowhere on
     this page is the column wide enough to stop them: 5 entries wrap at 320, 2 at 375, 1
     at 430, none from 768 up. An absolutely positioned bar -- the header's own method --
     would draw one rectangle under the last line at the width of the widest, i.e. a bottom
     border on the title block. `box-decoration-break: clone` gives each line fragment its
     own rule, each opening from its own centre: the worst case at 375 is 235.44 x 48.33
     over 2 fragments of 186.45 and 235.44, and it gets two rules of those widths.

     `clone` is documented to disable `text-wrap: balance`, which these titles use, so it
     was A/B'd rather than assumed: every entry's box, fragment count, fragment widths and
     the document height are identical with `clone` and with `slice` at 320, 375, 430 and
     768. The balancer only diverges in columns narrower than this page ever gets.

     No --wipe-y. The background's 100% is the padding-box bottom, which lands 3px under a
     20px baseline -- the same row `text-underline-offset: 0.14em` was putting it on, so
     the rule does not move at all here, it only acquires the motion.

     What does change is colour: from-font black becomes --crimson, which is what "like the
     header" means and is the first accent on this index. A 2px rule is a non-text element
     needing 3:1; crimson measures 7.25:1 on --page-bg. */
  @media (hover: hover) {
    /* The row wash used to sit outside this gate while the rule under the title sat inside
       it. On a touch screen :hover latches after a tap, so a tapped row kept its wash until
       the next tap elsewhere while the title's rule did not — one half of the row's hover
       state stuck to it and the other half did not. Both halves are the same gesture and
       now share the same gate. */
    .entry:hover { background-color: var(--ppc-wash); }
    .entry:hover .entry__title a { color: var(--crimson); }
  }
  /* Keyboard parity, which this row never had: the outline below marks the row, and this
     marks the title the same way the pointer does. Outside the gate on purpose.
     The row hit area is re-measured after the change and unmoved: 1024 x 61, with all
     four corners and the centre hit-testing to the link through the ::before above. */
  /* Hover is a colour step, not a rule. The reference draws its animated underline in one
     place only - the header nav - and every link in the body of a page, its writing index,
     its code list and even its year rail, simply lifts from rgb(160,32,32) to
     rgb(192,48,48) with no decoration at all. Measured over CDP on all three. */
  .entry__title a:focus-visible { color: var(--crimson); }

  /* Forced colours drop background-image, so the wipe is not painted there at all and the
     colour step is overridden too -- see the note beside .hover-wipe in base.css. The
     underline this rule replaced is what that mode can still draw, so it comes back here
     and only here. Written in this file rather than in base.css because Astro scopes a
     page rule on every compound, which outranks the same selector written globally. */
  @media (forced-colors: active) {
    .entry__title a:focus-visible { text-decoration: underline; text-underline-offset: 0.14em; }
  }
  @media (forced-colors: active) and (hover: hover) {
    .entry:hover .entry__title a { text-decoration: underline; text-underline-offset: 0.14em; }
  }

  .entry__title a:focus-visible { outline: 0; }
  .entry__title a:focus-visible::before {
    outline: 2px solid var(--ppc-ui);
    outline-offset: 3px;
  }

  /* Deck. None exist yet; when backfilled it lands on row 2 with no layout change. */
  .entry__deck {
    grid-column: 2;
    margin: 0.375rem 0 0;
    font-family: var(--font-body);
    font-size: var(--fs-medium);
    line-height: var(--lh-base);
    color: var(--ink);
    word-break: keep-all;
    text-wrap: pretty;
  }

  /* Folds when the rail no longer fits.
     The page title is .sr-only and its wrapper is gone, so there is nothing here to un-indent. */
  @container index (max-width: 36rem) {
    .index__empty,
    .year__label { padding-left: 0; }

    .entry { grid-template-columns: minmax(0, 1fr); }

    .entry__date {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      margin-bottom: 0.25rem;
    }

    .entry__title { grid-column: 1; grid-row: 2; }
    .entry__deck  { grid-column: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry { transition: none; }
  }
</style>
