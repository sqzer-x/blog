---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { hasHangul } from '../lib/hangul';
import { assertRendered } from '../lib/rendered';
import reading from '../lib/goodreads.json';

const entry = await getEntry('about', 'about');
assertRendered(entry!);
const { Content } = await render(entry!);

/* The reading list: the most recently finished books on the Goodreads read shelf, which
   scripts/goodreads.mjs fetches at build time. A book with no finish date sorts by the day
   it was shelved. The subtitle after ": " is dropped, "Collective Illusions" rather than
   the eleven words after it, so a title holds to a line or two. */
const READING_COUNT = 5;
const books = [...reading.books]
  .sort((a, b) => (b.readAt ?? b.addedAt ?? '').localeCompare(a.readAt ?? a.addedAt ?? ''))
  .slice(0, READING_COUNT);
const shortTitle = (t: string) => t.replace(/:\s.*$/, '');
const ym = (iso: string) => `${iso.slice(0, 4)}.${iso.slice(5, 7)}`;
/* Kana or CJK ideographs. Japanese titles are common on the shelf, and lang="ja" is what
   picks a Japanese voice and Japanese glyph forms over the page's lang="en". */
const KANA_KANJI = /[぀-ヿ一-鿿]/;
const titleLang = (t: string) => (hasHangul(t) ? 'ko' : KANA_KANJI.test(t) ? 'ja' : undefined);

/* Ask the body, not the metadata. The title and description below are English whatever
   about.md says, so only the body can tell whether the page needs the 118KB Korean face.
   about.md is English throughout today, so the answer is false and the page fetches no
   Korean font. The test stays because the answer is the body's to give: one Korean line
   added to about.md starts needing that face, and nothing else in this file would
   notice. The reading list is part of the body for this purpose: a Korean book title
   needs the face just as a Korean sentence does. */
const ko = hasHangul(entry!.body) || books.some((b) => hasHangul(b.title + b.author));
---
<Base
  title="sqzer"
  description="Hyukjin An — software and security engineer, and a founder, in South Korea."
  ko={ko}
>
  {/* about.md is running prose with no headings, the shape the reference's own home page
      uses. The bar's left slot prints the name but it is a <span>, not a heading — so the
      page needs one here or it has no h1 at all. A `#` heading in the body would not
      serve either: satteriProse demotes it to h2. Visually hidden for the same reason as
      the other section pages: the reference prints no page title either. */}
  <h1 class="sr-only">About</h1>
  <article class="about"><Content /></article>

  {/* Rows on the Writing index's pattern: a date rail, the title, and here the rating in
      place of a deck. The stars are drawn twice over, filled and empty, and hidden from
      assistive tech, which reads the rating from the label instead. */}
  {books.length > 0 && (
    <section class="reading" aria-labelledby="reading">
      <h2 class="reading__label" id="reading">Reading</h2>
      <ol class="reading__list">
        {books.map((b) => (
          <li class="book">
            {b.readAt && <time class="book__date" datetime={b.readAt.slice(0, 7)}>{ym(b.readAt)}</time>}
            <p class="book__body">
              <a class="book__title" href={b.url} lang={titleLang(b.title)}>{shortTitle(b.title)}</a>
              <span class="book__author">{b.author}</span>
            </p>
            {b.rating > 0 && (
              <span class="book__rating" role="img" aria-label={`Rated ${b.rating} out of 5`}>
                <span class="book__stars" aria-hidden="true">{'★'.repeat(b.rating)}</span><span class="book__stars book__stars--empty" aria-hidden="true">{'★'.repeat(5 - b.rating)}</span>
              </span>
            )}
          </li>
        ))}
      </ol>
      <p class="reading__more"><a href="https://www.goodreads.com/user/show/205369673-hyukjin-an">More on Goodreads</a></p>
    </section>
  )}
</Base>

{/* is:global for the same reason the article page uses it: the elements <Content />
    emits carry no scope id, so a scoped selector would miss every one of them. */}
<style is:global>
  /* The pair the article page carries on .prose, restated here because this is the one
     page that renders <Content /> without that wrapper. keep-all is the house rule
     wherever Korean can appear. The break rules at the end of this block
     (`.about :is(p, li, h1, h2, h3, h4)` and `.about a`) are the escape for a long
     unbroken token such as a bare URL: left unbroken it sets the page's minimum width,
     and `/` scrolls sideways on a phone. */
  .about { word-break: keep-all; }

  /* The portrait, set the way the reference sets its own: floated to the inline end with
     the prose running beside it, not a banner above the text. It is the first figure in
     the document and the only one on this page, so the selector is :first-child rather
     than a class the author would have to remember to type in markdown.

     Two things it buys beyond looking composed. It pulls the reading measure in from the
     full 1024px this page gets over the paragraphs it passes, which is the direction this
     page's line length wanted to move anyway. And the 4:5 portrait keeps its own aspect
     from the width/height satteriProse stamps on the <img>, so nothing reflows when it
     loads.

     Below 40rem the float comes off: the picture and the column beside it would both be
     too narrow, and the reference drops its own block to full width at a similar point. */
  .about > .fig:first-child {
    float: inline-end;
    inline-size: min(14.5rem, 34%);
    margin: 0 0 var(--sp-40) var(--sp-48);
    shape-margin: var(--sp-40);
  }
  .about > .fig:first-child img { inline-size: 100%; block-size: auto; }

  /* Clears the float so the footer, and anything else after the prose, cannot ride up
     beside the picture when the prose beside it ends first. */
  .about::after { content: ""; display: block; clear: both; }

  @media (max-width: 40rem) {
    .about > .fig:first-child {
      float: none;
      inline-size: min(12rem, 45%);
      margin: 0 0 var(--sp-40);
    }
  }
  .about :is(p, li, h1, h2, h3, h4) { overflow-wrap: break-word; }
  .about a { overflow-wrap: anywhere; }

  /* The label is the site's kicker idiom with its 4px x 3rem rule, as on the Writing
     index's year headings, rather than a second heading style for one section. */
  .reading { margin-block-start: var(--sp-48); }
  .reading__label {
    margin: 0 0 var(--sp-40);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: var(--lh-medium);
    letter-spacing: 0.105rem;
    text-transform: uppercase;
    color: var(--ppc-text);
  }
  .reading__label::before {
    content: "";
    display: block;
    inline-size: 3rem;
    border-top: 4px solid var(--ppc-ui);
    margin-block-end: var(--sp-40);
  }
  /* Each book is a Writing index row in miniature: the same 72px date rail and 24px gap,
     hairlines between rows, a title in --page-fg that steps to crimson under the pointer.
     The rail carries the month the book was finished; the rating takes the end column. */
  .reading__list { list-style: none; margin: 0; padding: 0; }
  .book {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    grid-template-areas: "date body rating";
    column-gap: 1.5rem;
    align-items: baseline;
    padding-block: var(--sp-30);
    border-bottom: 1px solid var(--page-hairline);
  }
  .book:last-child { border-bottom: none; }
  .book__date {
    grid-area: date;
    justify-self: end;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--page-meta);
    white-space: nowrap;
  }
  .book__body { grid-area: body; margin: 0; line-height: var(--lh-medium); }
  .book__title {
    font-family: var(--font-display);
    font-size: var(--fs-h6);
    font-weight: 500;
    color: var(--page-fg);
  }
  .book__title:is(:hover, :focus-visible) { color: var(--crimson); }
  .book__author {
    margin-inline-start: 0.6em;
    font-size: var(--fs-small);
    color: var(--page-meta);
    white-space: nowrap;
  }
  .book__rating { grid-area: rating; font-size: var(--fs-small); letter-spacing: 0.08em; white-space: nowrap; }
  .book__stars { color: var(--crimson); }
  .book__stars--empty { color: var(--page-hairline); }
  .reading__more {
    margin-block-start: var(--sp-40);
    padding-inline-start: calc(4.5rem + 1.5rem);
    font-size: var(--fs-small);
  }

  /* Below 40rem the rail would leave the title too narrow a column beside the rating, so
     the month moves above the title and the rows start at the page edge. */
  @media (max-width: 40rem) {
    .book {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "date date" "body rating";
    }
    .book__date { justify-self: start; }
    .reading__more { padding-inline-start: 0; }
  }
</style>
