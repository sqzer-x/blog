---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props { title: string; description?: string; section?: string }
const { title, description, section = 'slate' } = Astro.props;
const NAV = [
  { label: 'About',   href: '/' },
  { label: 'Papers',  href: '/papers/' },
  { label: 'Talk',    href: '/talk/' },
  { label: 'Code',    href: '/code/' },
  { label: 'Writing', href: '/writing/' },
];
const here = Astro.url.pathname;
// An exact match would leave every nav item unmarked on /writing/2026/vtzero/.
// Only '/' compares exactly, so that About is not current on every page.
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="sqzer" href="/index.xml" />
    <link rel="preload" href="/fonts/newsreader-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={`is-${section}`}>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a href="/">sqzer</a>
      <nav>
        {NAV.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
